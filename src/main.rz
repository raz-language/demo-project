import regex::program;
import regex::engine;
import std::io::stdio;

extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);
extern fn raz_rt_store_u8(usize address, i64 value) -> i64;
extern fn raz_rt_stdio_write(i64 stream, usize data, i64 size) -> i64;
extern fn raz_rt_time_monotonic_nanos() -> i64;

fn print_status(i64 status) -> bool {
    usize bytes = raz_rt_alloc(32);

    if (bytes == 0) {
        return false;
    }

    // "regex test: "
    raz_rt_store_u8(bytes + 0, 114);
    raz_rt_store_u8(bytes + 1, 101);
    raz_rt_store_u8(bytes + 2, 103);
    raz_rt_store_u8(bytes + 3, 101);
    raz_rt_store_u8(bytes + 4, 120);
    raz_rt_store_u8(bytes + 5, 32);
    raz_rt_store_u8(bytes + 6, 116);
    raz_rt_store_u8(bytes + 7, 101);
    raz_rt_store_u8(bytes + 8, 115);
    raz_rt_store_u8(bytes + 9, 116);
    raz_rt_store_u8(bytes + 10, 58);
    raz_rt_store_u8(bytes + 11, 32);

    if (status == 0) {
        // "PASS"
        raz_rt_store_u8(bytes + 12, 80);
        raz_rt_store_u8(bytes + 13, 65);
        raz_rt_store_u8(bytes + 14, 83);
        raz_rt_store_u8(bytes + 15, 83);
    } else {
        // "FAIL"
        raz_rt_store_u8(bytes + 12, 70);
        raz_rt_store_u8(bytes + 13, 65);
        raz_rt_store_u8(bytes + 14, 73);
        raz_rt_store_u8(bytes + 15, 76);
    }

    // newline
    raz_rt_store_u8(bytes + 16, 10);

    // "status: "
    raz_rt_store_u8(bytes + 17, 115);
    raz_rt_store_u8(bytes + 18, 116);
    raz_rt_store_u8(bytes + 19, 97);
    raz_rt_store_u8(bytes + 20, 116);
    raz_rt_store_u8(bytes + 21, 117);
    raz_rt_store_u8(bytes + 22, 115);
    raz_rt_store_u8(bytes + 23, 58);
    raz_rt_store_u8(bytes + 24, 32);

    i64 length = 25;

    if (status >= 10) {
        i64 tens = status / 10;
        i64 ones = status - (tens * 10);

        raz_rt_store_u8(bytes + length, 48 + tens);
        length += 1;

        raz_rt_store_u8(bytes + length, 48 + ones);
        length += 1;
    } else {
        raz_rt_store_u8(bytes + length, 48 + status);
        length += 1;
    }

    raz_rt_store_u8(bytes + length, 10);
    length += 1;

    i64 written = 0;

    while (written < length) {
        i64 count = raz_rt_stdio_write(
            1,
            bytes + written,
            length - written
        );

        if (count <= 0) {
            raz_rt_dealloc(bytes);
            return false;
        }

        written += count;
    }

    raz_rt_dealloc(bytes);

    return true;
}

fn make_pattern() -> usize {
    usize pattern = raz_rt_alloc(5);

    if (pattern == 0) {
        return 0;
    }

    // ^a+b$
    raz_rt_store_u8(pattern + 0, 94);
    raz_rt_store_u8(pattern + 1, 97);
    raz_rt_store_u8(pattern + 2, 43);
    raz_rt_store_u8(pattern + 3, 98);
    raz_rt_store_u8(pattern + 4, 36);

    return pattern;
}

fn make_input() -> usize {
    usize input = raz_rt_alloc(4);

    if (input == 0) {
        return 0;
    }

    // aaab
    raz_rt_store_u8(input + 0, 97);
    raz_rt_store_u8(input + 1, 97);
    raz_rt_store_u8(input + 2, 97);
    raz_rt_store_u8(input + 3, 98);

    return input;
}

fn test_regex_match() -> i64 {
    usize pattern = make_pattern();
    usize input = make_input();

    // regex::program::compile() measures its program buffer in i64 words.
    // Allocate 2048 words = 16384 bytes.
    usize program_storage = raz_rt_alloc(2048 * 8);

    if (
        pattern == 0 ||
        input == 0 ||
        program_storage == 0
    ) {
        if (pattern != 0) {
            raz_rt_dealloc(pattern);
        }

        if (input != 0) {
            raz_rt_dealloc(input);
        }

        if (program_storage != 0) {
            raz_rt_dealloc(program_storage);
        }

        return 10;
    }

    regex::program::Regex compiled;

    if (!regex::program::compile(
        pattern,
        5,
        program_storage,
        2048,
        &mut compiled
    )) {
        raz_rt_dealloc(program_storage);
        raz_rt_dealloc(input);
        raz_rt_dealloc(pattern);

        return 11;
    }

    //
    // IMPORTANT:
    //
    // Use is_match() here rather than find().
    //
    // find() returns regex::program::Match by value. The previous test proved
    // that the actual regex matched, but its start/end fields were corrupted
    // when the Match aggregate crossed the package/function ABI boundary.
    //
    // is_match() keeps Match internal to regex::engine and returns a scalar
    // bool, avoiding that aggregate-return lowering problem.
    //
    bool matched =
        regex::engine::is_match(
            &compiled,
            input,
            4
        );

    i64 status = 0;

    if (!matched) {
        status = 12;
    }

    raz_rt_dealloc(program_storage);
    raz_rt_dealloc(input);
    raz_rt_dealloc(pattern);

    return status;
}


fn benchmark_kernel(i64 iterations) -> i64 {
    // A deterministic integer workload that is large enough to expose native
    // backend code-generation differences while staying quick enough to run as
    // part of the normal demo. The checksum keeps the loop observable.
    i64 state = 1;
    i64 checksum = 0;
    i64 index = 0;

    while (index < iterations) {
        state = (state * 48271) % 2147483647;
        checksum += state & 1023;

        if ((state & 7) == 0) {
            checksum -= index & 31;
        }

        index += 1;
    }

    return checksum;
}

fn print_benchmark_metric(string label, i64 value) -> bool {
    if (!std::io::stdio::print(label)) {
        return false;
    }

    return std::io::stdio::println_i64(value);
}

fn run_backend_benchmark() -> bool {
    i64 iterations = 10000000;

    // Warm the process and make the warm-up observable through the final
    // checksum so an optimizer cannot discard it as dead work.
    i64 warmup_checksum = benchmark_kernel(100000);

    i64 started_nanos = raz_rt_time_monotonic_nanos();
    i64 checksum = benchmark_kernel(iterations);
    i64 elapsed_nanos = raz_rt_time_monotonic_nanos() - started_nanos;

    if (elapsed_nanos <= 0) {
        return false;
    }

    checksum += warmup_checksum;

    i64 nanos_per_iteration = elapsed_nanos / iterations;
    i64 iterations_per_second = (iterations * 1000000000) / elapsed_nanos;

    if (!std::io::stdio::println("native backend benchmark")) {
        return false;
    }
    if (!print_benchmark_metric("  iterations: ", iterations)) {
        return false;
    }
    if (!print_benchmark_metric("  elapsed_ns: ", elapsed_nanos)) {
        return false;
    }
    if (!print_benchmark_metric("  ns_per_iteration: ", nanos_per_iteration)) {
        return false;
    }
    if (!print_benchmark_metric("  iterations_per_second: ", iterations_per_second)) {
        return false;
    }
    if (!print_benchmark_metric("  checksum: ", checksum)) {
        return false;
    }

    return true;
}

fn main() -> i64 {
    i64 status = test_regex_match();

    if (!print_status(status)) {
        return 20;
    }

    if (status != 0) {
        return status;
    }

    if (!run_backend_benchmark()) {
        return 21;
    }

    return 0;
}